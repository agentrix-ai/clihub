      "keywords": ["创建", "日程", "日历", "calendar", "event", "create"],
      "argv_template": ["dws", "calendar", "event", "create"],
      "example": "dws calendar event create --summary \"需求评审\" --start \"2026-04-02 14:00\" --end \"2026-04-02 15:00\""
    },
    {
      "category": "calendar",
      "name": "room_list",
      "description": "查询可用会议室列表",

      "keywords": ["更新", "修改", "待办", "todo", "task", "update"],
      "argv_template": ["dws", "todo", "task", "update"],
      "example": "dws todo task update --task-id TASK_ID --done true"
    },
    {
      "category": "oa",
      "name": "approval_list",

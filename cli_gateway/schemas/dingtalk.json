      "keywords": ["创建", "群聊", "群", "chat", "group", "create"],
      "argv_template": ["dws", "chat", "group", "create"],
      "example": "dws chat group create --title \"项目群\" --robot-code BOT_CODE"
    },
    {
      "category": "chat",
      "name": "group_list",
      "description": "查询群列表",
      "description_en": "List group chats",
      "keywords": ["群聊", "列表", "chat", "group", "list"],
      "argv_template": ["dws", "chat", "group", "list"],
      "example": "dws chat group list"
    },
    {
      "category": "calendar",
      "name": "event_list",

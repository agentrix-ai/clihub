      "argv_template": ["dws", "calendar", "busy", "query"],
      "example": "dws calendar busy query --user-ids user1,user2 --start \"2026-04-02 09:00\" --end \"2026-04-02 18:00\""
    },
    {
      "category": "todo",
      "name": "task_list",

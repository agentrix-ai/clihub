      "argv_template": ["dws", "report", "list"],
      "example": "dws report list"
    },
    {
      "category": "aitable",
      "name": "record_query",
      "description": "查询智能表格记录",
      "description_en": "Query AITable records",
      "keywords": ["多维表格", "表格", "记录", "aitable", "base", "record", "query"],
      "argv_template": ["dws", "aitable", "record", "query"],
      "example": "dws aitable record query --base-id BASE_ID --table-id TABLE_ID"
    },
    {
      "category": "aitable",
      "name": "record_create",
